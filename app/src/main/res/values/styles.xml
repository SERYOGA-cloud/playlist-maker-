<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Базовая тема приложения -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Цвета темы -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>

        <item name="android:colorBackground">@color/screen_bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Кнопки Material -->
        <item name="materialButtonStyle">@style/Widget.PlaylistMaker.Button</item>

        <!-- Цвет статус-бара под тёмной шапкой Фигмы -->
        <item name="android:statusBarColor">@color/colorPrimaryVariant</item>
    </style>

    <!-- Кнопка-карточка на главном экране -->
    <style name="Widget.PlaylistMaker.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/card_radius</item>
        <item name="android:background">@color/main_button_background</item>
        <item name="iconTint">@color/card_icon</item>
        <item name="android:textColor">@color/card_text</item>
    </style>

    <!-- Заголовок карточки (текст внутри большой кнопки) -->
    <style name="TextAppearance.PlaylistMaker.CardTitle"
        parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/card_text</item>
        <item name="fontFamily">@font/ys_bold_24</item>
    </style>

    <!-- Заголовок тулбара -->
    <style name="TextAppearance.PlaylistMaker.ToolbarTitle"
        parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/toolbar_title</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>

