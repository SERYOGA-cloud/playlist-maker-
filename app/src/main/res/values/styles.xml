<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text.Main.CardTitle" parent="TextAppearance.MaterialComponents.TitleMedium">
        <item name="android:textSize">@dimen/main_button_text_size</item>
        <item name="android:textColor">@color/text_primary_dark</item>
    </style>

    <style name="Widget.PlaylistMaker.MainButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAppearance">@style/Text.Main.CardTitle</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/main_button_min_height</item>
        <item name="cornerRadius">@dimen/main_button_corner_radius</item>
        <item name="backgroundTint">@color/main_button_background</item>
        <item name="iconTint">@color/text_primary_dark</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/main_button_icon_padding</item>
    </style>

    <style name="Widget.PlaylistMaker.SettingsButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAppearance">@style/Text.Main.CardTitle</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/main_button_corner_radius</item>
        <item name="backgroundTint">@color/main_button_background</item>
        <item name="iconTint">@color/text_primary_dark</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/settings_item_icon_padding</item>
    </style>
</resources>
