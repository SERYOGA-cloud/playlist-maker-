<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/screen_bg"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/settings_title"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <LinearLayout
            android:id="@+id/rowTheme"
            style="@style/SettingsRow">

            <TextView
                style="@style/SettingsRowText"
                android:text="@string/settings_dark_theme"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowShare"
            style="@style/SettingsRow">

            <TextView
                style="@style/SettingsRowText"
                android:text="@string/settings_share"/>

            <ImageView
                android:id="@+id/iconShare"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share"
                android:tint="@color/icon_inactive"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSupport"
            style="@style/SettingsRow">

            <TextView
                style="@style/SettingsRowText"
                android:text="@string/settings_support"/>

            <ImageView
                android:id="@+id/iconSupport"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_support"
                android:tint="@color/icon_inactive"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowTerms"
            style="@style/SettingsRow">

            <TextView
                style="@style/SettingsRowText"
                android:text="@string/settings_terms"/>

            <ImageView
                android:id="@+id/iconTerms"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/icon_inactive"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
