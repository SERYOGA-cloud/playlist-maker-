<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:paddingStart="@dimen/screen_padding_h"
    android:paddingEnd="@dimen/screen_padding_h"
    android:paddingTop="@dimen/screen_padding_top"
    android:paddingBottom="@dimen/screen_padding_bottom">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/toolbar_height"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/app_title"
        app:titleTextColor="@color/text_primary_dark" />

    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/main_buttons_top_offset"
        android:orientation="vertical"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSearch"
            style="@style/Widget.PlaylistMaker.MainButton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/main_button_spacing_vertical"
            android:gravity="start|center_vertical"
            android:paddingStart="@dimen/main_button_content_padding"
            android:paddingEnd="@dimen/main_button_content_padding"
            android:paddingTop="@dimen/main_button_content_padding"
            android:paddingBottom="@dimen/main_button_content_padding"
            app:icon="@drawable/ic_search_24"
            app:iconSize="@dimen/main_button_icon_size"
            android:text="@string/btn_search" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLibrary"
            style="@style/Widget.PlaylistMaker.MainButton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/main_button_spacing_vertical"
            android:gravity="start|center_vertical"
            android:paddingStart="@dimen/main_button_content_padding"
            android:paddingEnd="@dimen/main_button_content_padding"
            android:paddingTop="@dimen/main_button_content_padding"
            android:paddingBottom="@dimen/main_button_content_padding"
            app:icon="@drawable/ic_library_24"
            app:iconSize="@dimen/main_button_icon_size"
            android:text="@string/btn_library" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSettings"
            style="@style/Widget.PlaylistMaker.MainButton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:paddingStart="@dimen/main_button_content_padding"
            android:paddingEnd="@dimen/main_button_content_padding"
            android:paddingTop="@dimen/main_button_content_padding"
            android:paddingBottom="@dimen/main_button_content_padding"
            app:icon="@drawable/ic_settings_24"
            app:iconSize="@dimen/main_button_icon_size"
            android:text="@string/btn_settings" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
